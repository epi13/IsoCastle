; Engine configuration file.
; Edit through the Godot editor when practical.

config_version=5

[application]

config/name="IsoCastle"
config/description="An original isometric fantasy role-playing game."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.025, 0.035, 0.055, 1)
boot_splash/show_image=false

[autoload]

ContentDB="*res://game/autoload/content_db.gd"
SettingsService="*res://game/autoload/settings_service.gd"
SaveService="*res://game/autoload/save_service.gd"
GameSession="*res://game/autoload/game_session.gd"
AudioDirector="*res://game/autoload/audio_director.gd"
WebBridge="*res://game/autoload/web_bridge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.018, 0.026, 0.043, 1)

[audio]

default_bus_layout="res://default_bus_layout.tres"

[input]

move_north={"deadzone":0.35,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320),Object(InputEventJoypadButton,"button_index":11)]}
